      "asset_slots": ["IMG/char/mouse/bust", "IMG/accessory/*"]
    },
    {
      "id": "SCR_15_Loading",
      "group": "Match flow",
      "title": "Loading",
      "runtime_gate": "phase-6-or-later",
      "requirements": ["pre-battle only", "player cards", "tip and progress"],
