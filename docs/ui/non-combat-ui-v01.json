{
  "schema_version": 1,
  "status": "accepted-design-contract",
  "product": {
    "display_name": "Forest Arena",
    "logo_text": "FOREST ARENA",
    "slug": "forest-arena"
  },
  "scope": {
    "current_phase": 0,
    "deliverable": "non-combat-ui-design-foundation",
    "in_game_combat_hud_included": false,
    "deferred": [
      "godot-screen-implementation",
      "image-generation",
      "penpot-file-editing",
      "account-shop-rank-social-backends",
      "online-match-implementation"
    ]
  },
  "resolution": {
    "penpot_reference": [1920, 1080],
    "runtime_logical": [1280, 720],
    "orientation": "landscape"
  },
  "rules": {
    "modes": ["Story", "Solo", "Team", "AI", "Practice"],
    "participants": {
      "max_total": 8,
      "team": {
        "min_per_team": 1,
        "max_per_team": 4,
        "max_total": 8
      }
    },
    "accessories": {
      "rarity_or_grade": false,
      "forbidden_cues": ["rarity-stars", "rarity-tiers", "rarity-color-frames", "legendary-epic-labels", "loot-grades"]
    },
    "splash": {
      "characters_allowed": false
    },
    "missing_assets": {
      "placeholder_name": "exact-IMG-slot",
      "visible_register": "MISSING ASSETS",
      "silent_final_image_substitution": false
    }
  },
  "art_direction": {
    "style": "original bright painterly fantasy forest",
    "pixel_art": false,
    "palette": ["sky-blue", "mint", "fresh-green", "cobalt-blue", "warm-gold"],
    "materials": ["translucent-glass", "carved-wood", "light-stone"],
    "character_direction": "approved three-head-proportion character concepts remain authoritative",
    "third_party_copying": false
  },
  "screen_transitions": {"loading_delay_msec": 150, "placement": "center", "skip_when_fast": true, "applies_to": "navigation only, not same-page controls or pause/resume"},
  "screens": [
    {
      "id": "SCR_01_Splash",
      "group": "Launch",
      "title": "Splash",
      "runtime_gate": "phase-6-title-loading-implemented",
      "requirements": ["character-free forest", "logo", "loading progress", "bottom startup progress", "fresh touch anywhere after ready", "native version and copyright"],
      "runtime": {"scene": "res://scenes/startup_title.tscn", "background_asset_id": "fa.background.title.forest", "start_text": "게임 시작", "version_setting": "application/config/version", "copyright": "© 2026 Forest Arena. All rights reserved."},
      "asset_slots": ["IMG/bg/splash", "IMG/logo/main"]
    },
    {
      "id": "SCR_02_Login",
      "group": "Launch",
      "title": "Login",
      "runtime_gate": "account-approval-required",
      "requirements": ["forest village", "start action", "secondary login actions"],
      "asset_slots": ["IMG/bg/login", "IMG/logo/main"]
    },
    {
      "id": "SCR_03_Lobby",
      "group": "Lobby/meta",
      "title": "Lobby",
      "runtime_gate": "phase-6-or-later",
      "requirements": ["play is dominant", "preset summary", "mission and event cards"],
      "asset_slots": ["IMG/bg/lobby", "IMG/char/mouse/full", "IMG/illust/event-01"]
    },
    {
      "id": "SCR_04_CharacterCollection",
      "group": "Lobby/meta",
      "title": "Character Collection",
      "runtime_gate": "character-approval-required",
      "requirements": ["role filters", "approved roster identities", "selected preview"],
      "asset_slots": ["IMG/bg/character-room", "IMG/char/mouse/face", "IMG/char/rabbit/face", "IMG/char/roster/*"]
    },
    {
      "id": "SCR_05_CharacterDetail",
      "group": "Lobby/meta",
      "title": "Character Detail",
      "runtime_gate": "phase-6-or-later",
      "requirements": ["large character art", "role and gameplay traits", "skills combo story tabs"],
      "asset_slots": ["IMG/bg/character-room", "IMG/char/mouse/full"]
    },
    {
      "id": "SCR_06_AccessoryCollection",
