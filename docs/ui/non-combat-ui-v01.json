      "group": "Match flow",
      "title": "Matchmaking",
      "runtime_gate": "phase-7-online",
      "requirements": ["selected mode and preset", "elapsed timer", "cancel action"],
      "asset_slots": ["IMG/bg/matchmaking"]
    },
    {
      "id": "SCR_12_MatchFound",
      "group": "Match flow",
      "title": "Match Found",
