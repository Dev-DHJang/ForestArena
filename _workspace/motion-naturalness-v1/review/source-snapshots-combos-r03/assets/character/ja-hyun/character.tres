[resource]
script = ExtResource("1_data")
character_id = &"ja-hyun"
display_name = "자현"
concept_asset_id = &"ja-hyun-concept-v01"
concept_image = ExtResource("3_image")
concept_summary = "은백발·큰 둥근 쥐 귀·길고 가는 털 없는 쥐 꼬리와 청·백·흑 후드 스트리트웨어를 갖춘 3등신 성인 남성 인간형 격투가. 낮은 자세와 긴 파란 리본으로 거리 조절과 공격 준비를 읽힌다."
background_setting = "숲 마을의 빠른 심부름꾼으로, 침착하게 거리를 재고 동료를 먼저 위험에서 빼낸다."
combat_role = "균형형 근접 격투가"
tags = Array[StringName]([&"mouse", &"striker", &"balanced"])
move_slot_ids = Array[StringName]([&"ja-hyun-light-combo", &"ja-hyun-heavy-sweep", &"ja-hyun-ribbon-rush"])
passive_description = "정확한 간격 유지 뒤 이어지는 근접 압박을 지향한다. 실제 효과는 향후 PassiveData에서 정의한다."
job_tree_ids = Array[StringName]([&"ja-hyun-prototype-job"])
base_stats = SubResource("CharacterStats_ja_hyun")
base_move_set = ExtResource("1_lyxsk")
