concept_asset_id = &"myo-ryung-concept-v01"
concept_image = ExtResource("3_image")
concept_summary = "은백발·분홍 안쪽의 긴 흰 토끼 귀와 분홍·흰색 스포티 의상을 갖춘 3등신 성인 여성 인간형 격투가. 긴 귀·리본·큰 운동화와 킥 자세로 공중 진입을 읽히며 작은 흰 꼬리는 측면·후면에서만 허용한다."
background_setting = "숲 축제의 길잡이였던 묘령은 낯선 길에서도 먼저 뛰어들어 동료가 따라올 길을 만든다."
combat_role = "고기동 공중 압박형"
tags = Array[StringName]([&"rabbit", &"aerial", &"mobile"])
move_slot_ids = Array[StringName]([&"myo-ryung-light-hop", &"myo-ryung-heavy-kick", &"myo-ryung-skybound"])
passive_description = "빠른 이동과 공중 위치 선점을 지향한다. 실제 효과는 향후 PassiveData에서 정의한다."
base_stats = SubResource("CharacterStats_myo_ryung")
