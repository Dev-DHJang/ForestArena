# 이 파일은 예시다. 실제 실행 시 scripts/db-dev.sh up 이 무작위 비밀번호가 든
# database/.env.development 파일을 만든다.
FOREST_ARENA_DB_PORT=55432
FOREST_ARENA_DB_NAME=forest_arena_dev
FOREST_ARENA_DB_ADMIN_USER=forest_arena_admin
FOREST_ARENA_DB_ADMIN_PASSWORD=CHANGE_ME
FOREST_ARENA_DB_APP_USER=forest_arena_app
FOREST_ARENA_DB_APP_PASSWORD=CHANGE_ME
FOREST_ARENA_DB_ENVIRONMENT=development
FOREST_ARENA_SERVER_BIND_HOST=127.0.0.1
FOREST_ARENA_API_PORT=3000
FOREST_ARENA_GAME_PORT=7777
FOREST_ARENA_ADVERTISED_WS_URL=ws://127.0.0.1:7777
FOREST_ARENA_TOKEN_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS
FOREST_ARENA_SERVICE_TOKEN=CHANGE_ME_AT_LEAST_32_CHARACTERS
